"""Type stubs for lobsim (the compiled part is lobsim._lobsim)."""

import enum
from typing import final

import numpy as np
import numpy.typing as npt

from . import paper as paper

__all__ = [
    "Fill",
    "Level",
    "OrderBook",
    "OrderInfo",
    "ReplayResult",
    "Side",
    "Status",
    "SubmitResult",
    "paper",
    "replay_lobster",
]

class Side(enum.IntEnum):
    """Order side. Values match LOBSTER's direction field: Bid = 1, Ask = -1."""

    Bid = 1
    Ask = -1

class Status(enum.Enum):
    """Outcome of a mutating call; anything but Ok means rejected, book unchanged."""

    Ok = 0
    InvalidId = 1
    InvalidPrice = 2
    InvalidQty = 3
    DuplicateId = 4
    UnknownId = 5

@final
class Fill:
    def __init__(
        self,
        *,
        resting_id: int,
        aggressor_id: int,
        resting_side: Side,
        price: int,
        qty: int,
        ts: int,
        resting_left: int,
    ) -> None: ...
    @property
    def resting_id(self) -> int: ...
    @property
    def aggressor_id(self) -> int: ...
    @property
    def resting_side(self) -> Side: ...
    @property
    def price(self) -> int: ...
    @property
    def qty(self) -> int: ...
    @property
    def ts(self) -> int: ...
    @property
    def resting_left(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Level:
    def __init__(self, *, price: int, qty: int, count: int) -> None: ...
    @property
    def price(self) -> int: ...
    @property
    def qty(self) -> int: ...
    @property
    def count(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class OrderInfo:
    def __init__(self, *, id: int, side: Side, price: int, qty: int, ts: int) -> None: ...
    @property
    def id(self) -> int: ...
    @property
    def side(self) -> Side: ...
    @property
    def price(self) -> int: ...
    @property
    def qty(self) -> int: ...
    @property
    def ts(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class SubmitResult:
    @property
    def status(self) -> Status: ...
    @property
    def filled(self) -> int: ...
    @property
    def resting(self) -> int: ...
    @property
    def fills(self) -> tuple[Fill, ...]: ...
    @property
    def ok(self) -> bool: ...

@final
class OrderBook:
    def __init__(self) -> None: ...
    def reserve(self, max_orders: int, max_levels: int) -> None: ...
    def clear(self) -> None: ...
    def submit_limit(
        self, id: int, side: Side, price: int, qty: int, ts: int = 0
    ) -> SubmitResult: ...
    def submit_market(self, id: int, side: Side, qty: int, ts: int = 0) -> SubmitResult: ...
    def replace(self, id: int, new_price: int, new_qty: int, ts: int = 0) -> SubmitResult: ...
    def cancel(self, id: int) -> Status: ...
    def reduce(self, id: int, by_qty: int) -> Status: ...
    def add_resting(self, id: int, side: Side, price: int, qty: int, ts: int = 0) -> Status: ...
    def execute_resting(self, id: int, qty: int, ts: int = 0) -> SubmitResult: ...
    def best(self, side: Side) -> Level | None: ...
    def best_bid(self) -> Level | None: ...
    def best_ask(self) -> Level | None: ...
    def mid(self) -> float | None: ...
    def spread(self) -> int | None: ...
    def front(self, side: Side) -> OrderInfo | None: ...
    def find(self, id: int) -> OrderInfo | None: ...
    def queue_ahead(self, id: int) -> int | None: ...
    def depth(self, side: Side, n: int) -> npt.NDArray[np.int64]: ...
    def order_count(self) -> int: ...
    def level_count(self, side: Side) -> int: ...
    def total_qty(self, side: Side) -> int: ...
    def __len__(self) -> int: ...
    def check_invariants(self, require_uncrossed: bool = True) -> tuple[bool, str]: ...

@final
class ReplayResult:
    @property
    def messages(self) -> int: ...
    @property
    def rejected(self) -> int: ...
    @property
    def first_rejected(self) -> int: ...
    @property
    def count_by_type(self) -> npt.NDArray[np.int64]: ...
    @property
    def rejected_by_type(self) -> npt.NDArray[np.int64]: ...
    @property
    def bid_price(self) -> npt.NDArray[np.int64] | None: ...
    @property
    def bid_qty(self) -> npt.NDArray[np.int64] | None: ...
    @property
    def ask_price(self) -> npt.NDArray[np.int64] | None: ...
    @property
    def ask_qty(self) -> npt.NDArray[np.int64] | None: ...

def replay_lobster(
    book: OrderBook,
    time_ns: npt.NDArray[np.int64],
    type: npt.NDArray[np.int8],
    order_id: npt.NDArray[np.uint64],
    size: npt.NDArray[np.int64],
    price: npt.NDArray[np.int64],
    direction: npt.NDArray[np.int8],
    *,
    capture_top: bool = False,
) -> ReplayResult: ...
